# PSPi: one picture for starting up, one for shutting down, one for restarting,
# with a line that slides along the bottom while it waits.
#
# systemd starts Plymouth in "shutdown" mode to power off and in "reboot" mode to restart.

Window.SetBackgroundTopColor(0.05, 0.02, 0.13);
Window.SetBackgroundBottomColor(0.05, 0.02, 0.13);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

# the picture, scaled to cover the screen and centred
fun scaled(name) {
    img = Image(name);
    sx = screen_w / img.GetWidth();
    sy = screen_h / img.GetHeight();
    s = sx;
    if (sy > sx) s = sy;
    return img.Scale(img.GetWidth() * s, img.GetHeight() * s);
}

backdrop = Sprite();
backdrop.SetZ(-100);

fun show_screen(name) {
    img = scaled(name);
    backdrop.SetImage(img);
    backdrop.SetX(Window.GetX() + (screen_w - img.GetWidth()) / 2);
    backdrop.SetY(Window.GetY() + (screen_h - img.GetHeight()) / 2);
}

mode = Plymouth.GetMode();
if (mode == "shutdown")
    show_screen("shutdown.png");
else if (mode == "reboot")
    show_screen("reboot.png");
else
    show_screen("boot.png");

# the sliding line
track_img = Image("bar-track.png");
seg_img = Image("bar-seg.png");
bar_w = screen_w * 0.40;
bar_scale = bar_w / track_img.GetWidth();
track_img = track_img.Scale(bar_w, track_img.GetHeight() * bar_scale);
seg_img = seg_img.Scale(seg_img.GetWidth() * bar_scale, seg_img.GetHeight() * bar_scale);
bar_x = Window.GetX() + (screen_w - bar_w) / 2;
bar_y = Window.GetY() + screen_h * 0.90;

track = Sprite(track_img);
track.SetX(bar_x);
track.SetY(bar_y);
track.SetZ(10);
seg = Sprite(seg_img);
seg.SetY(bar_y);
seg.SetZ(11);

phase = 0;
fun refresh() {
    global.phase = global.phase + 0.035;
    travel = bar_w - seg_img.GetWidth();
    seg.SetX(bar_x + travel * (0.5 - 0.5 * Math.Cos(global.phase)));
}
Plymouth.SetRefreshFunction(refresh);
